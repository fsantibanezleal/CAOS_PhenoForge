{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.exclude": ["**/.venv/**", "**/build/**", "**/dist/**"],
  "python.analysis.indexing": false,
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/build": true,
    "**/dist": true
  }
}
